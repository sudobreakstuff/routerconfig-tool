{
  "name": "routerconfig-pro",
  "version": "1.1.0",
  "description": "Multi-vendor router auto-configuration and remote management",
  "main": "electron/main.js",
  "repository": "https://github.com/sudobreakstuff/routerconfig-tool",
  "author": {
    "name": "Shahid Singh",
    "email": "shahidsingh1zn@gmail.com"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zustand": "^5.0.0",
    "axios": "^1.7.7",
    "lucide-react": "^0.460.0",
    "d3": "^7.9.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "xterm-addon-web-links": "^0.9.0",
    "react-hot-toast": "^2.4.1",
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/d3": "^7.4.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.sudobreakstuff.routerconfig-pro",
    "productName": "RouterConfig Pro",
    "artifactName": "RouterConfigPro-${version}-${arch}.${ext}",
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Network"
    },
    "win": {
      "target": ["nsis"],
      "artifactName": "RouterConfigPro-${version}-win64-Setup.${ext}"
    },
    "extraResources": [
      {
        "from": "../backend/dist/routerconfig-backend",
        "to": "backend"
      }
    ]
  }
}
